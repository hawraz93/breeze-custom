{
    "name": "hawraz/breeze",
    "description": "Laravel authentication scaffolding with Blade, Tailwind, and Arabic/Kurdish RTL support.",
    "keywords": [
        "laravel",
        "auth",
        "rtl",
        "arabic",
        "kurdish"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/hawraz/breeze/issues",
        "source": "https://github.com/hawraz/breeze"
    },
    "authors": [
        {
            "name": "Hawraz",
            "email": "hawrazn1@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "symfony/console": "^7.0|^8.0"
    },
    "require-dev": {
        "laravel/framework": "^11.0|^12.0|^13.0",
        "orchestra/testbench-core": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Hawraz\\Breeze\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hawraz\\Breeze\\BreezeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
